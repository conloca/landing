{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "figma-desktop": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "figma-framelink": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp@0.13.2",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_PAT}",
        "IMAGE_DIR": "${PWD}/src/assets/figma",
        "DO_NOT_TRACK": "1",
        "FRAMELINK_TELEMETRY": "off"
      }
    }
  }
}
