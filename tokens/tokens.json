        "$value": [
          "Inter Variable",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Inter v4 exposes the Display cut through the opsz axis, so \"Inter Display\" in the design is this same family at a high optical size, not a second font."
      },
      "mono": {
        "$value": [
          "Roboto Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "File names, code snippets, diffs, line numbers."
