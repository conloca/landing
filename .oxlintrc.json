{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-perf",
    "typescript",
    "unicorn",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__revealFailsafe"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "scripts/**",
        "vite.config.ts"
      ],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19.0"
    }
  }
}
